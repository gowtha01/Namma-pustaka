    <style name="Theme.NammaPustaka" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/amber_500</item>
        <item name="colorOnPrimary">@color/forest_900</item>
        <item name="colorSecondary">@color/success_500</item>
        <item name="android:statusBarColor">@color/forest_900</item>
        <item name="android:navigationBarColor">@color/forest_900</item>
        <item name="android:windowBackground">@color/forest_900</item>
        <item name="colorSurface">@color/forest_800</item>
        <item name="colorOnSurface">@color/sand_100</item>
        <item name="android:textColor">@color/sand_100</item>
        <item name="materialCardViewStyle">@style/Widget.NammaPustaka.Card</item>
